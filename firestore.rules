rules_version = '2';

// Every habit belongs to one user (`author` = Firebase Auth uid). Only that user may
// read, change or delete it. Validation is per changed field, so habits written by
// older app versions stay editable even if they carry fields this file doesn't know.
//
// Anything not matched below is denied, including the `fcmTokens` collection from an
// earlier, unmerged notifications experiment.
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in, and with a password only once the email is verified: otherwise someone
    // could sign up with another person's address first and share their account when
    // that person later signs in with Google. Google and GitHub sessions pass as before.
    function isTrustedUser() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider != 'password'
          || request.auth.token.email_verified == true);
    }

    match /habits/{habitId} {
      function isSignedIn() {
        return isTrustedUser();
      }

      function ownsExisting() {
        return isSignedIn() && resource.data.author == request.auth.uid;
      }

      function isValidName(name) {
        return name is string && name.size() > 0 && name.size() <= 200;
      }

      function isValidDescription(description) {
        return description is string && description.size() <= 2000;
      }

      function isValidGoal(goal) {
        return goal is map && (
          (goal.keys().hasOnly(['type']) && goal.type == 'daily') ||
          (goal.keys().hasOnly(['type', 'times']) && goal.type == 'weekly'
            && goal.times is int && goal.times >= 1 && goal.times <= 6)
        );
      }

      // Rules can't loop over list entries, so only the number of days is capped
      // (about 10 years of daily entries). The 1 MiB document limit caps the rest.
      function isValidStreak(streak) {
        return streak is list && streak.size() <= 4000;
      }

      // The habit's place in the user's own sorted list (0, 1, 2, …).
      function isValidOrder(order) {
        return order is int && order >= 0 && order <= 10000;
      }

      function changedFieldsAreValid() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let data = request.resource.data;
        return changed.hasOnly(['name', 'description', 'goal', 'streak', 'order'])
          && (!('name' in changed) || isValidName(data.name))
          && (!('description' in changed) || isValidDescription(data.description))
          && (!('goal' in changed) || isValidGoal(data.goal))
          && (!('streak' in changed) || isValidStreak(data.streak))
          && (!('order' in changed) || isValidOrder(data.order));
      }

      function isValidNewHabit() {
        let data = request.resource.data;
        return data.keys().hasOnly(['name', 'description', 'goal', 'streak', 'createdAt', 'author'])
          && data.keys().hasAll(['name', 'description', 'goal', 'streak', 'author'])
          && data.author == request.auth.uid
          && isValidName(data.name)
          && isValidDescription(data.description)
          && isValidGoal(data.goal)
          && isValidStreak(data.streak)
          && (!('createdAt' in data) || data.createdAt is int);
      }

      // `get` and `list` both check the stored author. A list query is only allowed
      // when it filters on the caller's own author, as getAllHabits does.
      allow read: if ownsExisting();
      allow create: if isSignedIn() && isValidNewHabit();
      allow update: if ownsExisting() && changedFieldsAreValid();
      allow delete: if ownsExisting();
    }

    // Daily reminder settings, one document per user (id = uid): the hours (up to three;
    // `hour` is the first, for older app versions) and time zone to remind at, one push
    // token per device, the last day on which every habit was done (lastMarkedDate), and
    // the day and hour of the last reminder sent. Only the user may touch it; the reminder
    // sender (scripts/send-reminders.mjs) uses server credentials.
    match /reminders/{uid} {
      function isOwner() {
        return isTrustedUser() && request.auth.uid == uid;
      }

      function isValidReminder(data) {
        return data.keys().hasOnly(['hour', 'hours', 'timeZone', 'tokens', 'lastMarkedDate', 'lastRemindedDate', 'lastRemindedHour', 'progress', 'language'])
          && data.keys().hasAll(['hour', 'timeZone', 'tokens'])
          && isHour(data.hour)
          // `hour` must stay the first of `hours`: an older app version that changes only
          // `hour` then gets an error instead of a change the sender would ignore.
          && (!('hours' in data) || (isValidHours(data.hours) && data.hours[0] == data.hour))
          && (!('lastRemindedHour' in data) || isHour(data.lastRemindedHour))
          && data.timeZone is string && data.timeZone.size() > 0 && data.timeZone.size() <= 64
          && data.tokens is list && data.tokens.size() <= 10
          && isDateOrMissing(data, 'lastMarkedDate')
          && isDateOrMissing(data, 'lastRemindedDate')
          && (!('progress' in data) || isValidProgress(data.progress))
          // The language the reminder is written in, as chosen in the app.
          && (!('language' in data) || data.language in ['en', 'sv']);
      }

      function isHour(h) {
        return h is int && h >= 0 && h <= 23;
      }

      // Rules can't loop, so each of the (at most three) entries is checked by index.
      function isValidHours(hours) {
        return hours is list && hours.size() >= 1 && hours.size() <= 3
          && isHour(hours[0])
          && (hours.size() < 2 || isHour(hours[1]))
          && (hours.size() < 3 || isHour(hours[2]));
      }

      // Counts for the day, never habit names (see ReminderProgress in reminderService).
      function isValidProgress(p) {
        return p is map
          && p.keys().hasOnly(['date', 'left', 'total', 'openChain', 'doneChain'])
          && p.keys().hasAll(['date', 'left', 'total', 'openChain', 'doneChain'])
          && p.date is string && p.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && isCount(p.left, 500) && isCount(p.total, 500) && p.left <= p.total
          && isCount(p.openChain, 10000) && isCount(p.doneChain, 10000);
      }

      function isCount(n, max) {
        return n is int && n >= 0 && n <= max;
      }

      function isDateOrMissing(data, key) {
        return !(key in data)
          || (data[key] is string && data[key].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && isValidReminder(request.resource.data);
    }
  }
}
